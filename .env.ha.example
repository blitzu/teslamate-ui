# Optional: Home Assistant link (see docs/home-assistant.md). Copy to .env.ha
HA_URL='http://homeassistant.local:8123'
HA_TOKEN='long-lived-access-token'
# Entity prefix of the esphome-tesla-ble device (entities like lock.<prefix>_doors, switch.<prefix>_charger)
HA_BLE_PREFIX='tesla_ble'
# Use the local BLE path first when the ESP32 is connected to the car, fall back to the Fleet API otherwise
BLE_FIRST='1'
# Optional: sensors (in W) used to estimate how much of a charge came from the grid vs solar
HA_GRID_IMPORT='sensor.inverter_grid_import_power'
HA_PV_POWER='sensor.inverter_pv_power'
