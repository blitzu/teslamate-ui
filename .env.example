# Copy to .env (./setup.sh does it for you) and edit.
# IMPORTANT: if a value contains $ or other special characters, wrap it in single quotes: DATABASE_PASS='pa$$word'

# --- TeslaMate database (the same credentials TeslaMate itself uses) ---
DATABASE_HOST=database
DATABASE_USER=teslamate
DATABASE_PASS=changeme
DATABASE_NAME=teslamate

# --- TeslaMate MQTT (live state). Leave MQTT_HOST empty to disable live data (history pages still work). ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_NAMESPACE=

# --- Optional links shown at the bottom of the car page ---
TESLAMATE_URL=
GRAFANA_URL=

# --- Display ---
CURRENCY=€

# --- Time zone (for time-based automations), e.g. Europe/Bucharest ---
TZ=UTC

# --- Docker ---
# Name of the Docker network of your TeslaMate stack (docker network ls). Default for a stack in a folder called "teslamate":
TESLAMATE_NETWORK=teslamate_default
# UI_PORT=4100
# PUBLIC_PORT=4101

# --- Optional (most can also be set from the app: Settings) ---
# APP_PIN=               # command PIN (min. 6 characters); prefer Settings or scripts/set-fleet.sh
# APP_PASSWORD=          # app password (min. 12 chars): also protects the local network; prefer scripts/set-password.sh
# APP_URL=               # address opened when you tap a notification, e.g. https://car.example.com
# PRICE_GRID=            # your electricity price per kWh (for the "real cost" of home charges)
# ICE_L100=7.5           # consumption of a petrol/diesel car for the comparison (l/100 km)
# FUEL_TYPE=euro95       # euro95 | diesel | manual
# FUEL_PRICE=            # manual fuel price per litre (FUEL_TYPE=manual or fallback)
# FUEL_COUNTRY=Romania   # country for the automatic fuel price (fuel-prices.eu)
# ROLES=wife@example.com:family,guest@example.com:viewer
# DATA_DIR=/data         # where settings and tokens are stored inside the container
# APP_UID=10001          # unprivileged user the container drops to (it starts as root only to hand DATA_DIR to that user)
# CSP=                   # override the Content-Security-Policy header
# DB_MAX_CONN=8          # max. simultaneous Postgres connections
# MAX_SSE=60             # max. simultaneous live-stream connections
