FROM golang:alpine AS build
RUN apk add --no-cache git
# go install nu merge (go.mod are directive replace) -> clonam si compilam, versiune fixata
RUN git clone --depth 1 --branch v0.4.1 https://github.com/teslamotors/vehicle-command /src
WORKDIR /src
RUN go build -o /out/tesla-http-proxy ./cmd/tesla-http-proxy

FROM alpine:3.20
COPY --from=build /out/tesla-http-proxy /usr/local/bin/tesla-http-proxy
ENTRYPOINT ["tesla-http-proxy"]
